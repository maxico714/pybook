# Copy these into your shell environment before `python run.py`.
# This file is documentation, not a loader: the app reads the real environment.
# (Flask would only auto-load a .env if python-dotenv were installed, and this
# project installs nothing at runtime.)

# Signs the small Flask session that carries the CSRF token.
# Leave unset for a local run: a random key is generated once into
# instance/secret_key and reused, so open forms survive a restart.
# Set it explicitly when you deploy, and keep it secret.
# PYBOOK_SECRET_KEY=change-me-to-a-long-random-string

# Where the server listens. Keep 127.0.0.1 for a local-only classroom.
# PYBOOK_HOST=127.0.0.1
# PYBOOK_PORT=5000

# Set to 1 only when the site is served over HTTPS: the session cookie then
# gets the Secure flag and the browser refuses to send it over http.
# PYBOOK_SECURE_COOKIES=0

# Development conveniences. Never enable debug on a shared machine.
# PYBOOK_DEBUG=0
