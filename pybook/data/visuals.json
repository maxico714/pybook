ewBox=\"0 0 640 180\" width=\"100%\" role=\"img\" aria-label=\"async/await lets one task wait while another one uses the time.\" style=\"font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;max-width:100%;height:auto\"><style>.pulse{animation:pulse 2.4s ease-in-out infinite}@keyframes pulse{0%,100%{opacity:.35}50%{opacity:1}}.slide{animation:slide 3s ease-in-out infinite}@keyframes slide{0%,100%{transform:translateX(0)}50%{transform:translateX(120px)}}.dash{animation:dash 2s linear infinite}@keyframes dash{to{stroke-dashoffset:-24}}.spin{animation:spin 6s linear infinite;transform-origin:center}@keyframes spin{to{transform:rotate(360deg)}}.fade{animation:fade 4s ease-in-out infinite}@keyframes fade{0%,45%{opacity:1}55%,100%{opacity:.25}}</style><defs><marker id=\"ah\" markerWidth=\"9\" markerHeight=\"9\" refX=\"8\" refY=\"4.5\" orient=\"auto\"><path d=\"M0,0 L9,4.5 L0,9 z\" fill=\"#334155\"/></marker></defs><text x=\"20\" y=\"40\" font-size=\"12\" fill=\"#334155\">task A</text><text x=\"20\" y=\"100\" font-size=\"12\" fill=\"#334155\">task B</text><rect x=\"90\" y=\"24\" width=\"150\" height=\"26\" rx=\"5\" fill=\"#dbeafe\" stroke=\"#1d4ed8\"/><text x=\"165\" y=\"42\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1d4ed8\">network wait</text><rect x=\"250\" y=\"24\" width=\"140\" height=\"26\" rx=\"5\" fill=\"#dbeafe\" stroke=\"#1d4ed8\"/><text x=\"320\" y=\"42\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1d4ed8\">more work</text><rect x=\"90\" y=\"84\" width=\"300\" height=\"26\" rx=\"5\" fill=\"#dcfce7\" stroke=\"#166534\"/><text x=\"240\" y=\"102\" text-anchor=\"middle\" font-size=\"11\" fill=\"#166534\">runs while A is waiting</text><text x=\"410\" y=\"42\" font-size=\"11.5\" fill=\"#334155\">await = pause here, let others run</text><text x=\"410\" y=\"102\" font-size=\"11.5\" fill=\"#334155\">one thread, no blocking</text><line x1=\"90\" y1=\"140\" x2=\"390\" y2=\"140\" stroke=\"#334155\" stroke-dasharray=\"4 4\"/><text x=\"90\" y=\"160\" font-s